# Neon Postgres — paste from Neon dashboard → Connection string

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth — generate secret: openssl rand -base64 32

BETTER_AUTH_SECRET="your-secret-here"

BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Job APIs ---

# No keys required: Remotive, Arbeitnow, Jobicy, RemoteOK, RemoteJobs.org, Career Nest

# JSearch — Google for Jobs (Indeed, LinkedIn, Glassdoor, etc.)
# https://app.openwebninja.com/api/jsearch  OR  RapidAPI JSearch
JSEARCH_API_KEY=""
RAPIDAPI_KEY=""
JSEARCH_QUERY="developer jobs"
JSEARCH_COUNTRIES="ph,us"
JSEARCH_NUM_PAGES="1"
# Advanced: custom queries — query|country per entry
# JSEARCH_QUERIES="developer jobs in Philippines|ph,developer jobs in United States|us"

# Adzuna — https://developer.adzuna.com/ (no Philippines feed; use sg for regional)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRIES="us,sg"
ADZUNA_DEFAULT_WHAT="developer"
ADZUNA_DEFAULT_WHERE=""

# Optional: Reed.co.uk UK jobs — https://www.reed.co.uk/developers
REED_API_KEY=""
