# Neon Postgres ΓÇö paste from Neon dashboard ΓåÆ Connection string

DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Better Auth ΓÇö generate secret: openssl rand -base64 32

BETTER_AUTH_SECRET="your-secret-here"

BETTER_AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: extra sign-in origins (comma-separated), e.g. a custom domain
# BETTER_AUTH_TRUSTED_ORIGINS="https://jobs.example.com"

# --- Job APIs ---

# No keys required: Remotive, Arbeitnow, Jobicy, RemoteOK, RemoteJobs.org, Career Nest, Workbeam, Jobs Base

WORKBEAM_QUERY="developer"
# WORKBEAM_REMOTE="global"
JOBSBASE_QUERY="developer"
JOBSBASE_COUNTRIES="US,GB,SG"
JOBSBASE_PAGES="2"

# Adzuna ΓÇö https://developer.adzuna.com/ (no Philippines feed; use sg for regional)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRIES="us,sg"
ADZUNA_DEFAULT_WHAT="developer"
ADZUNA_DEFAULT_WHERE=""

# Optional: Reed.co.uk UK jobs ΓÇö https://www.reed.co.uk/developers
REED_API_KEY=""

# --- Translation (German job descriptions to English) ---
# Optional: DeepL free tier — https://www.deepl.com/pro-api (best quality)
DEEPL_API_KEY=""
# Optional: LibreTranslate instance instead of MyMemory fallback
LIBRETRANSLATE_URL=""
LIBRETRANSLATE_API_KEY=""
