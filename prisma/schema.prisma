generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  applications  JobApplication[]
  profile       UserProfile?

  @@unique([email])
  @@map("user")
}

/// Job seeker details — preferences, links, and how employers can reach you.
model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline         String?
  phone            String?
  location         String?
  bio              String?  @db.Text
  linkedInUrl      String?
  portfolioUrl     String?
  githubUrl        String?
  contactEmail     String?
  coverLetter      String?  @db.Text
  resumeFileName   String?
  resumeMimeType   String?
  resumeSizeBytes  Int?
  resumeUpdatedAt  DateTime?
  preferredWork    String   @default("any")
  preferredTypes   Json     @default("[]")
  skills           Json     @default("[]")
  openToWork       Boolean  @default(true)
  yearsExperience  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("user_profile")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model JobSource {
  id         String        @id
  name       String
  kind       String        @default("api")
  enabled    Boolean       @default(true)
  lastSyncAt DateTime?
  lastStatus String?
  lastError  String?       @db.Text
  jobCount   Int           @default(0)
  listings   JobListing[]
  logs       JobSyncLog[]

  @@map("job_source")
}

/// Applicant-tracked job applications (where you applied, status, replies).
model JobApplication {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobListingId String?
  jobListing   JobListing? @relation(fields: [jobListingId], references: [id], onDelete: SetNull)
  title        String
  company      String
  location     String      @default("")
  applyUrl     String?
  source       String?
  status       String      @default("applied")
  hasReply     Boolean     @default(false)
  notes        String?     @db.Text
  appliedAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([userId, jobListingId])
  @@index([userId, appliedAt])
  @@index([userId, status])
  @@map("job_application")
}

model JobListing {
  id           String    @id @default(cuid())
  externalId   String
  sourceId     String
  source       JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  title        String
  company      String
  location     String
  salary       String    @default("Not disclosed")
  type         String    @default("Full-time")
  description  String    @db.Text
  requirements Json      @default("[]")
  benefits     Json      @default("[]")
  tags         Json      @default("[]")
  applyUrl     String?
  applyOnSite  Boolean   @default(false)
  logoUrl      String?
  postedAt     DateTime?
  syncedAt     DateTime  @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  applications JobApplication[]

  @@unique([sourceId, externalId])
  @@index([title])
  @@index([company])
  @@index([postedAt])
  @@map("job_listing")
}

model JobSyncLog {
  id          String    @id @default(cuid())
  sourceId    String
  source      JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status      String
  jobsAdded   Int       @default(0)
  jobsUpdated Int       @default(0)
  error       String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([sourceId, createdAt])
  @@map("job_sync_log")
}
